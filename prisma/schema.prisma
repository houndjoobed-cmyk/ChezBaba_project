generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Admin {
  userId String @id @map("user_id") @db.VarChar(25)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("admin")
}

model Adresse {
  id         String     @id @default(cuid()) @db.VarChar(25)
  rue        String     @db.VarChar(255)
  ville      String     @db.VarChar(100)
  quartier   String     @db.VarChar(100)
  codePostal String     @map("code_postal") @db.VarChar(20)
  commandes  Commande[]
  user       User[]

  @@map("adresse")
}

model Categorie {
  id             String      @id @default(cuid()) @db.VarChar(25)
  nom            String      @unique(map: "nom") @db.VarChar(100)
  description    String?     @db.VarChar(255)
  imagePublicId  String?     @map("image_public_id") @db.VarChar(255)
  parentId       String?     @map("parent_id") @db.VarChar(25)
  parent         Categorie?  @relation("CategorieParent", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  sousCategories Categorie[] @relation("CategorieParent")
  produits       Produit[]

  @@index([parentId], map: "index_categorie_parent_id")
  @@map("categorie")
}

model Couleur {
  id   String @id @default(cuid()) @db.VarChar(25)
  nom  String @unique @db.VarChar(50)
  code String @db.Char(7) // Code Hexadécimal

  produits      Produit[]       @relation("ProduitCouleurs")
  LigneCommande LigneCommande[]
  LignePanier   LignePanier[]

  @@map("couleur")
}

model Client {
  id           String        @id @db.VarChar(25)
  user         User          @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendeur      Vendeur?
  commandes    Commande[]
  signalements Signalement[]
  litiges      Litige[]

  @@map("client")
}

model Commande {
  id             String            @id @default(cuid()) @db.VarChar(25)
  date           DateTime          @default(now())
  montant        Decimal           @db.Decimal(10, 2)
  statut         CommandeStatut    @default(EN_ATTENTE_PAIEMENT)
  adresseId      String?           @map("adresse_id") @db.VarChar(25)
  panierId       String?           @map("panier_id") @db.VarChar(25)
  clientId       String?           @map("client_id") @db.VarChar(25)
  adresse        Adresse?          @relation(fields: [adresseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  panier         Panier?           @relation(fields: [panierId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  client         Client?           @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  lignesCommande LigneCommande[]
  paiement       Paiement?
  litige         Litige?
  transactionsPortefeuille TransactionPortefeuille[]
  entreesLivre   GrandLivrePlateforme[]

  @@index([clientId], map: "index_commande_client_id")
  @@index([panierId], map: "index_commande_panier_id")
  @@index([adresseId], map: "index_commande_adresse_id")
  @@map("commande")
}

model Evaluation {
  id                 String              @id @default(cuid()) @db.VarChar(25)
  note               Decimal             @db.Decimal(3, 2)
  text               String?             @db.VarChar(500)
  date               DateTime            @default(now())
  userId             String              @map("user_id") @db.VarChar(25)
  produitId          String              @map("produit_id") @db.VarChar(25)
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produit            Produit             @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reponsesEvaluation ReponseEvaluation[]

  @@index([produitId], map: "index_evaluation_produit_id")
  @@index([userId], map: "index_evaluation_user_id")
  @@map("evaluation")
}

model Genre {
  id       String    @id @default(cuid()) @db.VarChar(25)
  nom      String    @unique @db.VarChar(50)
  produits Produit[]

  @@map("genre")
}

model LigneCommande {
  id            String   @id @default(cuid()) @db.VarChar(25)
  nomProduit    String   @map("nom_produit") @db.VarChar(100)
  quantite      Int
  prixUnit      Decimal  @map("prix_unit") @db.Decimal(10, 2)
  imagePublicId String?  @map("image_public_id") @db.VarChar(255)
  commandeId    String   @map("commande_id") @db.VarChar(25)
  produitId     String?  @map("produit_id") @db.VarChar(25)
  couleurId     String?  @map("couleur_id") @db.VarChar(25)
  tailleId      String?  @map("taille_id") @db.VarChar(25)
  commande      Commande @relation(fields: [commandeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produit       Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  couleur       Couleur? @relation(fields: [couleurId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  taille        Taille?  @relation(fields: [tailleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([commandeId], map: "index_ligne_commande_commande_id")
  @@index([produitId], map: "index_ligne_commande_produit_id")
  @@index([couleurId], map: "index_ligne_commande_couleur_id")
  @@index([tailleId], map: "index_ligne_commande_taille_id")
  @@map("ligne_commande")
}

model LignePanier {
  id            String   @id @default(cuid()) @db.VarChar(25)
  nomProduit    String   @map("nom_produit") @db.VarChar(100)
  quantite      Int
  prixUnit      Decimal  @map("prix_unit") @db.Decimal(10, 2)
  imagePublicId String?  @map("image_public_id") @db.VarChar(255)
  panierId      String   @map("panier_id") @db.VarChar(25)
  produitId     String?  @map("produit_id") @db.VarChar(25)
  couleurId     String?  @map("couleur_id") @db.VarChar(25)
  tailleId      String?  @map("taille_id") @db.VarChar(25)
  panier        Panier   @relation(fields: [panierId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produit       Produit? @relation(fields: [produitId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  couleur       Couleur? @relation(fields: [couleurId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  taille        Taille?  @relation(fields: [tailleId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([panierId], map: "index_ligne_panier_panier_id")
  @@index([produitId], map: "index_ligne_panier_produit_id")
  @@index([couleurId], map: "index_ligne_panier_couleur_id")
  @@index([tailleId], map: "index_ligne_panier_taille_id")
  @@map("ligne_panier")
}

model Notification {
  id             String           @id @default(cuid()) @db.VarChar(25)
  type           NotificationType @default(DEFAULT)
  objet          String           @db.VarChar(255)
  text           String           @db.VarChar(1000)
  date           DateTime         @default(now())
  urlRedirection String?          @map("url_redirection") @db.VarChar(255)
  estLu          Boolean          @default(false) @map("est_lu")
  userId         String           @map("user_id") @db.VarChar(25)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "index_notification_user_id")
  @@map("notification")
}

// ==========================================
// MODÈLES DE PAIEMENT ESCROW KKIAPAY
// ==========================================

model Paiement {
  id                   String          @id @default(cuid()) @db.VarChar(25)
  date                 DateTime        @default(now())
  statut               PaiementStatut  @default(EN_ATTENTE)
  methode              MethodePaiement?
  montantBrut          Decimal         @map("montant_brut") @db.Decimal(10, 2)
  commissionPlateforme Decimal         @map("commission_plateforme") @db.Decimal(10, 2)
  montantNetVendeur    Decimal         @map("montant_net_vendeur") @db.Decimal(10, 2)
  fraisTransaction     Decimal         @default(0) @map("frais_transaction") @db.Decimal(10, 2)
  supporteurFrais      SupporteurFrais @default(CLIENT) @map("supporteur_frais")
  fournisseur          String          @default("KKIAPAY") @db.VarChar(50)
  referenceProvider    String?         @unique @map("reference_provider") @db.VarChar(255)
  webhookPayload       Json?           @map("webhook_payload")
  commandeId           String          @unique @map("commande_id") @db.VarChar(25)
  commande             Commande        @relation(fields: [commandeId], references: [id], onDelete: Cascade)

  @@index([commandeId], map: "index_paiement_commande_id")
  @@index([referenceProvider], map: "index_paiement_reference_provider")
  @@map("paiement")
}

model PortefeuilleVendeur {
  id           String                    @id @default(cuid()) @db.VarChar(25)
  vendeurId    String                    @unique @map("vendeur_id") @db.VarChar(25)
  solde        Decimal                   @default(0) @db.Decimal(12, 2)
  vendeur      Vendeur                   @relation(fields: [vendeurId], references: [id], onDelete: Cascade)
  transactions TransactionPortefeuille[]
  retraits     Retrait[]

  @@map("portefeuille_vendeur")
}

model TransactionPortefeuille {
  id             String              @id @default(cuid()) @db.VarChar(25)
  type           TypeTransaction
  montant        Decimal             @db.Decimal(10, 2)
  description    String?             @db.VarChar(500)
  date           DateTime            @default(now())
  commandeId     String?             @map("commande_id") @db.VarChar(25)
  portefeuilleId String              @map("portefeuille_id") @db.VarChar(25)
  portefeuille   PortefeuilleVendeur @relation(fields: [portefeuilleId], references: [id], onDelete: Cascade)
  commande       Commande?           @relation(fields: [commandeId], references: [id])

  @@index([portefeuilleId], map: "index_transaction_portefeuille_id")
  @@index([commandeId], map: "index_transaction_commande_id")
  @@map("transaction_portefeuille")
}

model Retrait {
  id             String              @id @default(cuid()) @db.VarChar(25)
  montant        Decimal             @db.Decimal(10, 2)
  statut         StatutRetrait       @default(EN_ATTENTE)
  methode        MethodePaiement     @default(MOBILE_MONEY)
  dateDemande    DateTime            @default(now()) @map("date_demande")
  dateTraitement DateTime?           @map("date_traitement")
  reference      String?             @db.VarChar(255)
  detailsDestination String?         @map("details_destination") @db.VarChar(255)
  portefeuilleId String              @map("portefeuille_id") @db.VarChar(25)
  portefeuille   PortefeuilleVendeur @relation(fields: [portefeuilleId], references: [id], onDelete: Cascade)

  @@index([portefeuilleId], map: "index_retrait_portefeuille_id")
  @@map("retrait")
}

model Litige {
  id          String       @id @default(cuid()) @db.VarChar(25)
  motif       String       @db.VarChar(500)
  description String?      @db.VarChar(1000)
  statut      StatutLitige @default(OUVERT)
  resolution  String?      @db.VarChar(1000)
  dateOuvert  DateTime     @default(now()) @map("date_ouvert")
  dateFerme   DateTime?    @map("date_ferme")
  commandeId  String       @unique @map("commande_id") @db.VarChar(25)
  clientId    String       @map("client_id") @db.VarChar(25)
  commande    Commande     @relation(fields: [commandeId], references: [id], onDelete: Cascade)
  client      Client       @relation(fields: [clientId], references: [id])

  @@index([commandeId], map: "index_litige_commande_id")
  @@index([clientId], map: "index_litige_client_id")
  @@map("litige")
}

model GrandLivrePlateforme {
  id          String    @id @default(cuid()) @db.VarChar(25)
  type        String    @db.VarChar(50) // "COMMISSION", "FRAIS_CARTE", "FRAIS_REVERSEMENT"
  montant     Decimal   @db.Decimal(10, 2)
  description String?   @db.VarChar(500)
  commandeId  String?   @map("commande_id") @db.VarChar(25)
  date        DateTime  @default(now())
  commande    Commande? @relation(fields: [commandeId], references: [id])

  @@index([commandeId], map: "index_grand_livre_commande_id")
  @@index([type], map: "index_grand_livre_type")
  @@map("grand_livre_plateforme")
}

// ==========================================
// FIN MODÈLES PAIEMENT ESCROW
// ==========================================

model Panier {
  id               String        @id @default(cuid()) @db.VarChar(25)
  statut           PanierStatut? @default(EN_COURS)
  dateCreation     DateTime?     @default(now()) @map("date_creation")
  dateModification DateTime?     @map("date_modification")
  userId           String        @map("user_id") @db.VarChar(25)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  commandes        Commande[]
  lignesPanier     LignePanier[]

  @@index([userId], map: "index_panier_user_id")
  @@map("panier")
}

model Produit {
  id                 String              @id @default(cuid()) @db.VarChar(25)
  nom                String              @db.VarChar(100)
  objet              String?             @db.VarChar(255)
  description        String?             @db.VarChar(1000)
  prix               Decimal             @db.Decimal(10, 2)
  qteStock           Int                 @map("qte_stock")
  noteMoyenne        Decimal             @default(0.0) @map("note_moyenne") @db.Decimal(2, 1)
  totalEvaluations   Int                 @default(0) @map("total_evaluations")
  dateCreation       DateTime            @default(now()) @map("date_creation") @db.Timestamp(0)
  dateModification   DateTime            @default(now()) @map("date_modification") @db.Timestamp(0)
  categorieId        String?             @map("categorie_id") @db.VarChar(25)
  genreId            String?             @map("genre_id") @db.VarChar(25)
  produitBoutique    ProduitBoutique?
  produitMarketplace ProduitMarketplace?
  delaiLivraison     String?             @map("delai_livraison") @db.VarChar(50)
  prixPromo          Decimal?            @map("prix_promo") @db.Decimal(10, 2)
  garantie           String?             @db.VarChar(50)
  
  // Nouveaux champs pour les produits digitaux
  typeProduit        TypeProduit         @default(PHYSIQUE) @map("type_produit")
  fichierUrl         String?             @map("fichier_url") @db.VarChar(1000)
  fichierNom         String?             @map("fichier_nom") @db.VarChar(255)
  messageApresAchat  String?             @map("message_apres_achat") @db.VarChar(2000)
  lienApresAchat     String?             @map("lien_apres_achat") @db.VarChar(1000)

  categorie          Categorie?          @relation(fields: [categorieId], references: [id], onUpdate: NoAction)
  genre              Genre?              @relation(fields: [genreId], references: [id], onUpdate: NoAction)
  couleurs           Couleur[]           @relation("ProduitCouleurs")
  tailles            Taille[]            @relation("ProduitTailles")
  lignesCommande     LigneCommande[]
  lignesPanier       LignePanier[]
  evaluations        Evaluation[]
  signalements       Signalement[]
  images             ProduitImage[]
  video              ProduitVideo?
  favoris            Favori[]

  @@index([categorieId], map: "index_categorie_id")
  @@index([genreId], map: "index_genre_id")
  @@index([qteStock], map: "index_qte_stock")
  @@map("produit")
}

model ProduitImage {
  id            String  @id @default(cuid()) @db.VarChar(25)
  imagePublicId String  @map("image_public_id") @db.VarChar(255)
  produitId     String  @map("produit_id") @db.VarChar(25)
  produit       Produit @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([produitId], map: "index_produit_image_produit_id")
  @@map("produit_image")
}

model ProduitVideo {
  id            String  @id @default(cuid()) @db.VarChar(25)
  videoPublicId String  @map("video_public_id") @db.VarChar(255)
  produitId     String  @unique @map("produit_id") @db.VarChar(25)
  produit       Produit @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([produitId], map: "index_produit_video_produit_id")
  @@map("produit_video")
}

model ProduitBoutique {
  produitId   String  @id @map("produit_id") @db.VarChar(25)
  fournisseur String? @db.VarChar(255)
  produit     Produit @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("produit_boutique")
}

model ProduitMarketplace {
  produitId String  @id @map("produit_id") @db.VarChar(25)
  vendeurId String  @map("vendeur_id") @db.VarChar(25)
  produit   Produit @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vendeur   Vendeur @relation(fields: [vendeurId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vendeurId], map: "index_vendeur_id")
  @@map("produit_marketplace")
}

model ReponseEvaluation {
  id           String     @id @default(cuid()) @db.VarChar(25)
  text         String     @db.VarChar(500)
  date         DateTime   @default(now())
  userId       String     @map("user_id") @db.VarChar(25)
  evaluationId String     @map("evaluation_id") @db.VarChar(25)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("reponse_evaluation")
}

model Signalement {
  id        String             @id @default(cuid()) @db.VarChar(25)
  objet     String?            @db.VarChar(255)
  text      String?            @db.VarChar(1000)
  reponse   String?            @db.VarChar(1000)
  statut    SignalementStatut? @default(EN_ATTENTE)
  date      DateTime?          @default(now())
  clientId  String?            @map("client_id") @db.VarChar(25)
  produitId String?            @map("produit_id") @db.VarChar(25)
  client    Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  produit   Produit?           @relation(fields: [produitId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([clientId], map: "index_client_id")
  @@index([produitId], map: "index_produit_id")
  @@map("signalement")
}

model Taille {
  id  String @id @default(cuid()) @db.VarChar(25)
  nom String @unique @db.VarChar(10)

  produits      Produit[]       @relation("ProduitTailles")
  LigneCommande LigneCommande[]
  LignePanier   LignePanier[]

  @@map("taille")
}

model TOTPSecret {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @unique @map("user_id") @db.VarChar(25)
  secret    String   @db.VarChar(64)
  expiresLe DateTime @map("exipre_le")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId], map: "index_user_id")
  @@map("totp_secret")
}

model User {
  id                 String              @id @default(cuid()) @db.VarChar(25)
  email              String              @unique(map: "unique_email") @db.VarChar(255)
  password           String?             @db.VarChar(255)
  nom                String              @default("") @db.VarChar(100)
  prenom             String              @default("") @db.VarChar(100)
  tel                String?             @db.VarChar(20)
  adresseId          String?             @map("adresse_id") @db.VarChar(25)
  imagePublicId      String?             @map("image_public_id") @db.VarChar(255)
  emailEnAttente     String?             @map("email_en_attente") @db.VarChar(255)
  emailVerifie       Boolean             @default(false) @map("email_verifie")
  dateCreation       DateTime            @default(now()) @map("date_creation")
  role               UserRole            @default(CLIENT)
  admin              Admin?
  client             Client?
  TOTPSecret         TOTPSecret?
  adresse            Adresse?            @relation(fields: [adresseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paniers            Panier[]
  evaluations        Evaluation[]
  notifications      Notification[]
  reponsesEvaluation ReponseEvaluation[]
  favoris            Favori[]

  accounts           Account[]
  @@index([email], map: "index_email")
  @@index([adresseId], map: "index_adresse_id")
  @@map("user")
}

model Account {
  id                String  @id @default(cuid()) @db.VarChar(25)
  userId            String  @map("user_id") @db.VarChar(25)
  type              String  @db.VarChar(50)
  provider          String  @db.VarChar(50)
  providerAccountId String  @map("provider_account_id") @db.VarChar(255)
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String? @db.VarChar(50)
  scope             String? @db.VarChar(255)
  id_token          String? @db.Text
  session_state     String? @db.VarChar(255)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "index_account_user_id")
  @@map("account")
}

model Vendeur {
  id                 String               @id @db.VarChar(25)
  nomBoutique        String               @map("nom_public") @db.VarChar(100)
  description        String?              @db.VarChar(1000)
  nomBanque          String               @map("nom_banque") @db.VarChar(50)
  rib                String               @db.VarChar(50)
  client             Client               @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  paiementVendeur    PaiementVendeur[]
  produitMarketplace ProduitMarketplace[]
  portefeuille       PortefeuilleVendeur?

  @@map("vendeur")
}

// ==========================================
// ENUMS
// ==========================================

enum TypeProduit {
  PHYSIQUE
  DIGITAL
}

enum PanierStatut {
  EN_COURS
  VALIDE
  ANNULE
}

enum PaiementStatut {
  EN_ATTENTE
  INITIE
  REUSSI
  ECHOUE
  REMBOURSE
}

enum SignalementStatut {
  EN_ATTENTE
  TRAITE
  REJETE
}

enum CommandeStatut {
  EN_ATTENTE_PAIEMENT
  PAYEE
  EN_PREPARATION
  EXPEDIEE
  LIVREE
  LIVRAISON_CONFIRMEE
  ANNULEE
  EN_LITIGE
  REMBOURSEE
}

enum UserRole {
  CLIENT
  VENDEUR
  ADMIN
}

enum NotificationType {
  DEFAULT
  COMMANDE
  LIVRAISON
  PAIEMENT
  SIGNALEMENT
  EVALUATION
  MESSAGE
  SECURITE
}

enum MethodePaiement {
  MOBILE_MONEY
  CARTE_BANCAIRE
}

enum SupporteurFrais {
  CLIENT
  PLATEFORME
}

enum TypeTransaction {
  CREDIT_VENTE
  DEBIT_RETRAIT
  COMMISSION
  REMBOURSEMENT
}

enum StatutRetrait {
  EN_ATTENTE
  APPROUVE
  TRAITE
  REJETE
}

enum StatutLitige {
  OUVERT
  EN_COURS
  RESOLU_CLIENT
  RESOLU_VENDEUR
  FERME
}

model Temoignage {
  id            String   @id @default(cuid()) @db.VarChar(25)
  nom           String   @db.VarChar(100)
  prenom        String   @db.VarChar(100)
  texte         String   @db.VarChar(500)
  note          Int      @default(5)
  imagePublicId String?  @map("image_public_id") @db.VarChar(255)
  date          DateTime @default(now())

  @@map("temoignage")
}

model Newsletter {
  id    String   @id @default(cuid()) @db.VarChar(25)
  email String   @unique @db.VarChar(255)
  date  DateTime @default(now())

  @@map("newsletter")
}

model Favori {
  id        String   @id @default(cuid()) @db.VarChar(25)
  userId    String   @map("user_id") @db.VarChar(25)
  produitId String   @map("produit_id") @db.VarChar(25)
  dateAjout DateTime @default(now()) @map("date_ajout")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  produit Produit @relation(fields: [produitId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([userId, produitId])
  @@index([userId], map: "index_favori_user_id")
  @@index([produitId], map: "index_favori_produit_id")
  @@map("favori")
}

// Ancien modèle conservé pour compatibilité avec les données existantes
model PaiementVendeur {
  id        String          @id @default(cuid()) @db.VarChar(25)
  montant   Decimal         @db.Decimal(10, 2)
  date      DateTime?       @default(now())
  statut    PaiementStatut? @default(EN_ATTENTE)
  vendeurId String          @map("vendeur_id") @db.VarChar(25)
  vendeur   Vendeur         @relation(fields: [vendeurId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([vendeurId], map: "index_paiement_vendeur_vendeur_id")
  @@map("paiement_vendeur")
}
